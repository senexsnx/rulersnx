{
  "manifest_version": 3,
  "name": "RulerSNX — Ruler & Guides",
  "version": "1.0.0",
  "description": "Illustrator-style ruler & draggable magenta guide lines over any website — verify optical axes, alignment and spacing. Rulers auto-hide so they never cover your content.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "RulerSNX"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/guides.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rulersnx@senex",
      "strict_min_version": "109.0"
    }
  }
}
